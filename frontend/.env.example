# =============================================================================
# Frontend Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values from CDK deployment outputs
#
# To get these values:
# 1. Deploy the CDK stacks: cd infrastructure && cdk deploy --all
# 2. Check CDK_DEPLOYMENT_OUTPUTS.md in the project root
# 3. Update the values below with your actual deployment outputs
# =============================================================================

# AWS Region Configuration
# Get this from: CDK outputs -> AWS Region
VITE_AWS_REGION=us-west-2

# AWS Cognito Configuration (for user authentication)
# Get these from: CDK ItalyTripPlannerUserAuthStack outputs
VITE_COGNITO_USER_POOL_ID=your-user-pool-id-here
VITE_COGNITO_CLIENT_ID=your-client-id-here

# API Gateway Endpoint (for itinerary CRUD operations)
# Get this from: CDK ItalyTripPlannerStack outputs -> API Endpoint
VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.us-west-2.amazonaws.com/prod/

# Environment
VITE_ENV=development

# Feature flags
VITE_ENABLE_MAP=true
VITE_ENABLE_RECOMMENDATIONS=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_CUSTOM_DATASET=true

# Performance optimization flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=true

# API request timeout (milliseconds)
VITE_API_TIMEOUT=10000

# Maximum places to fetch per request
VITE_MAX_PLACES_LIMIT=100

# Map configuration
VITE_MAP_DEFAULT_ZOOM=6
VITE_MAP_DEFAULT_CENTER_LAT=42.8333
VITE_MAP_DEFAULT_CENTER_LNG=12.8333

# Cache durations (milliseconds)
VITE_CACHE_PLACES_DURATION=300000
VITE_CACHE_RECOMMENDATIONS_DURATION=180000
