# Production Environment Configuration
# This file is used for production builds of the Italy Trip Planner frontend.
# 
# IMPORTANT: These values should be set during the build process using actual
# deployed infrastructure values. The placeholder values below should be replaced
# with real values from AWS CloudFormation outputs.
#
# To get the actual values after CDK deployment, run:
#   cd infrastructure && npm run get-config
# or manually retrieve from AWS Console / CloudFormation outputs

# API Gateway endpoint URL
# This should be the REST API endpoint created by CDK deployment
# Format: https://<api-id>.execute-api.<region>.amazonaws.com/prod/
# Example: https://abc123def4.execute-api.us-east-1.amazonaws.com/prod/
VITE_API_BASE_URL=https://PLACEHOLDER_API_GATEWAY_ID.execute-api.PLACEHOLDER_REGION.amazonaws.com/prod

# CloudFront distribution URL (optional - for CDN-optimized asset loading)
# This is the CloudFront domain name created by CDK deployment
# Format: https://<distribution-id>.cloudfront.net
# Example: https://d111111abcdef8.cloudfront.net
# Note: If you have a custom domain, use that instead
VITE_CLOUDFRONT_URL=https://PLACEHOLDER_DISTRIBUTION_ID.cloudfront.net

# Environment identifier
VITE_ENV=production

# Feature flags (production defaults)
VITE_ENABLE_MAP=true
VITE_ENABLE_RECOMMENDATIONS=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_CUSTOM_DATASET=true

# Performance optimization flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false

# Build-time configuration
# These are injected during the build process and become part of the static bundle
# DO NOT include sensitive secrets here - they will be visible in the client-side code

# API request timeout (milliseconds)
VITE_API_TIMEOUT=10000

# Maximum places to fetch per request
VITE_MAX_PLACES_LIMIT=100

# Map configuration
VITE_MAP_DEFAULT_ZOOM=6
VITE_MAP_DEFAULT_CENTER_LAT=42.8333
VITE_MAP_DEFAULT_CENTER_LNG=12.8333

# Cache durations (milliseconds)
VITE_CACHE_PLACES_DURATION=300000
VITE_CACHE_RECOMMENDATIONS_DURATION=180000
